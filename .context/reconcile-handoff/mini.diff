+      assert.notEqual(finalState.phases.p.changes.paused.tasks['1'].status, 'complete');
+      const authority = path.join(f.env.PROMETHEUS_DATA_DIR, 'prometheus/kbd/projects', finalState.projectId, 'project.loro');
