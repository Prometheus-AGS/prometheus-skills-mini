{
  "name": "prometheus-skills-mini",
  "version": "1.20.1",
  "private": true,
  "type": "module",
  "description": "Windows-native, scaled-down port of prometheus-skill-pack: KBD + PMPO process skills, OpenSpec, Karpathy logging.",
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "services": "node scripts/service-providers/cli.mjs",
    "install:native": "node scripts/install-native.mjs",
    "test": "node --test",
    "check": "node rules/build.mjs --check",
    "validate": "node scripts/validate-skills.mjs",
    "validate:strict": "node scripts/validate-skills.mjs --strict",
    "coverage": "node scripts/coverage-report.mjs",
    "context:bootstrap": "node scripts/prometheus-context-bootstrap.mjs",
    "context:check": "node scripts/prometheus-context-bootstrap.mjs --check",
    "spec:validate": "node scripts/spec-validate.mjs",
    "build:distribution": "node scripts/generate-skill-system-distribution.mjs",
    "check:distribution": "node scripts/generate-skill-system-distribution.mjs --check",
    "check:selected-method": "node scripts/check-selected-method-core.mjs",
    "check:contract-templates": "node scripts/generate-contract-templates.mjs --check",
    "check:harness-capabilities": "node scripts/check-harness-capabilities.mjs",
    "eval:vlbv-protocol": "node evals/vlbv-protocol/run.mjs",
    "generate:commands": "node scripts/generate-commands.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.1.0"
  }
}
