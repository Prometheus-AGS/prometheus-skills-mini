  "profile": {
    "basePath": "/api/uar/full-harness/v1",
    "profile": "full_harness_v1",
    "packageVersion": "1.0.0",
    "protocolVersion": 1,
    "recovery": "unsupported_after_restart",
    "retention": {
      "mode": "process_ephemeral",
      "terminal_ttl_seconds": "configured RunsConfig.retention_after_terminal_secs",
      "terminal_record_cap": "configured RunsConfig.max_retained_terminal; zero disables cap"
    },
    "steer_supported": false,
    "providerAncestryIsNotRuntimeAcceptance": true
  },
  "identity": {
    "requiredForFullHarness": [
      "authenticated non-anonymous subject",
      "typed tenant when remote",
      "x-uar-workspace-id selecting an operator-authorized mapping"
    ],
    "remoteMapping": "configured verified issuer + subject + tenant -> workspace; header/body never grants authority",
    "localLaunch": "SidecarGuard private launch proof + asserted local principal; distinct from JWT tenant identity",
    "serviceHost": "signed uar_credential_kind=issuer + exact trusted_host_principals issuer/subject/tenant -> host_id + destination trusted_hosts",
    "apiKeys": "direct and exchanged credentials preserve issuer/subject/tenant and attenuated roles; no service host or cross-owner admin promotion",
    "legacyTokens": "missing/unknown credential kind is unclassified; ordinary owner authority only",
    "downstream": "provider/MCP resource credential is not UAR authentication or host provenance"
  },
  "operations": [
    {
      "method": "GET",
      "path": "/capabilities",
      "request": "no body; authenticated principal",
      "response": "RuntimeDescriptor: profile,runtime_epoch,recovery,retention,steer_supported"
    },
    {
      "method": "POST",
      "path": "/tasks",
      "request": {
        "required": {
          "admission_id": "nonempty string",
          "native_task_id": "nonempty string",
          "input": "string"
        },
        "agentSelector": "artifact OR agent_id OR deployment_binding_id; ambiguity rejected",
        "optional": [
          "service_placement",
          "session_id",
          "run_credentials",
          "mcp_servers",
          "tool_admission",
          "working_directory",
          "reasoning_effort",
          "history",
          "skill_attachments",
          "flattened presentation negotiation"
        ]
      },
      "response": "202 TaskReceipt; reservation precedes native run entry; same owner/workspace/admission and identical canonical body digest replays frozen admission response",
      "idempotencyConflict": "409 admission_digest_conflict; do not replace admission_id to retry an uncertain effect"
    },
    {
      "method": "GET",
      "path": "/admissions/{admission_id}",
      "request": "same owner/workspace; no body",
      "response": "current process-local TaskReceipt or explicit unresolved/expired result"
    },
    {
      "method": "GET",
      "path": "/tasks/{task_id}",
      "request": "same owner/workspace; no body",
      "response": "TaskReceipt with current revision/state/cursor"
    },
    {
      "method": "GET",
      "path": "/tasks/{task_id}/stream",
      "request": "optional last_event_id:u64 query or Last-Event-ID header; query wins",
      "response": "existing native SSE history followed by live stream; duplicates suppressed; unrecoverable gap emitted rather than silently jumping"
    },
    {
      "method": "POST",
      "path": "/tasks/{task_id}/tool-approval",
      "request": {
        "expected_revision": "u64 required",
        "approved": "boolean required",
        "approval_id": "nonempty string from exact originating pending event required"
      },
      "response": "TaskReceipt; 409 revision_conflict or approval_unresolved leaves no alternative waiter selected"
    },
    {
      "method": "POST",
      "path": "/tasks/{task_id}/cancel",
      "request": {
        "expected_revision": "u64 required"
      },
      "response": "TaskReceipt.cancellation separates requested,acknowledged,terminal,cleanup_uncertain; acknowledgement is not terminal/effect reversal"
    },
    {
      "method": "POST",
      "path": "/tasks/{task_id}/detach",
      "request": {
        "expected_revision": "u64 required",
        "observer_id": "nonempty string required"
      },
      "response": "observer detach receipt; no execution cancellation"
    },
    {
      "method": "POST",
      "path": "/tasks/{task_id}/steer",
      "request": "owned task identity",
      "response": "422 capability_unsupported"
    }
  ],
  "receipt": {
    "required": [
      "admission_id",
      "task_id",
      "native_task_id",
      "run_id",
      "workspace_id",
      "runtime_epoch",
      "revision",
      "state",
      "retention",
      "cancellation",
      "detached",
      "detached_observers",
      "created_at",
      "unsupported_semantics",
      "links"
    ],
    "optional": [
      "agent_id",
      "cursor",
      "effective_service_binding",
      "diagnostics",
      "terminal_at",
      "expires_at"
    ],
    "states": [
      "reserved",
      "submitted",
      "working",
      "input_required",
      "completed",
      "failed",
      "cancelled",
      "rejected"
    ],
    "links": [
      "status",
      "stream",
      "tool_approval",
      "cancel",
      "detach",
      "steer"
    ]
  },
  "mapping": {
    "input": "Full harness uses CreateRunRequest.input, a string; do not send OpenAI messages as an implicit substitute.",
    "model": "Agent artifact policy.provider.default {provider,model}, with explicit fallback list; no top-level model field in full-harness CreateRunRequest.",
    "budgets": "No top-level full-harness budget request field. Artifact extensions.budgets carries BudgetsSection: max_tokens_per_turn,max_tokens_per_session,max_tool_calls_per_turn,max_cost_per_session_usd,timeout_seconds,rate_limit{requests_per_minute,tokens_per_minute}; consumer must map supported semantics deliberately, not assume arbitrary extra JSON is enforced.",
    "history": "history {session_id,messages}; exact request session match; <=1000 messages and <=4MiB counted payload; only user/assistant/tool roles; valid unique tool calls and corresponding nonduplicate results; warm session may ignore seed.",
    "tools": "Artifact tool allow/deny,max_concurrent,execution_mode; effective policy/governance and prepared host admission still apply. Chat compatibility tools field is not a tool grant.",
    "pairedAdmission": "tool_admission camelCase {version:1,hostEpoch,url,headers}; actual SidecarGuard authority required, HTTP loopback /uar/admission/v1; not enabled by ordinary JWT role or configured MCP service-host proof.",
    "credentials": "Run-local provider set requires default/fallback coverage; provider_kind openai_compatible or anthropic; secrets nonserialized/redacted. MCP grants require registered destination, typed host proof, scope/lease/owner constraints.",
    "reasoning": "none|low|medium|high|max only",
    "workingDirectory": "canonical existing directory input; not by itself filesystem authorization"
  },
  "modelProvider": {
    "paths": [
      "/api/chat/completion",
      "/v1/chat/completions"
    ],
    "implementation": "src/server.rs::api_chat_completion + server-local ChatCompletionRequest; not the smaller src/uar/api/openai/types.rs shape",
    "requestFields": [
      "model?",
      "messages[]",
      "message?",
      "temperature? compatibility",
      "tools[]? compatibility",
      "stream",
      "stream_mode / stream_format",
      "session_id?",
      "attachments[]",
      "memory_enabled",
      "prompt_caching_enabled?",
      "agent_id?",
      "run_policy?",
      "presentation negotiation"
    ],
    "replay": "stream=true + x-uar-run-id + Last-Event-ID together, owner-bound and stream-format matched",
    "limitation": "OpenAI completion surface does not return full_harness task receipt/admission/revision control contract; transport compatibility does not make it a full-harness provider."
  },
  "failures": {
    "400": [
      "admission_invalid",
      "workspace_required",
      "approval_invalid",
      "detach_invalid"
    ],
    "401": [
      "principal_invalid"
    ],
    "404": [
      "task_not_found",
      "task_unresolved for missing process-local admission"
    ],
    "409": [
      "admission_digest_conflict",
      "revision_conflict",
      "approval_unresolved",
      "recovery_unsupported"
    ],
    "410": [
      "retention_expired",
      "task_unresolved for current-epoch unavailable receipt/stream"
    ],
    "422": [
      "capability_unsupported"
    ],
    "envelope": "{error:{code,message,task_id?,admission_id?}}; native admission errors retain their status/code in rejected receipt",
    "unknown": "Lost create/effect response or prior epoch remains unknown/unsupported; reconcile exact admission/task under original owner/workspace, do not auto-submit a new invocation."
  },
  "consumerChecklist": [
    "Discover capabilities/profile and runtime_epoch before selecting full-harness behavior.",
    "Bind authenticated identity/workspace independently of downstream credentials.",
    "Retain admission_id + exact request body across uncertain create response, and task_id/native_task_id/run_id/epoch/revision/cursor from receipt.",
    "Submit exact approval ID plus current expected_revision; never substitute latest pending implicitly.",
    "Map budgets, model, history and tool constraints only through supported fields; report unsupported semantics.",
    "Treat cancellation receipt stages distinctly; never turn unknown or unsupported recovery into automatic replay."
  ],
  "priorHandoffs": [
    "uar-prerequisites.md",
    "identity-policy-authoring.md",
    "key-attenuation-authoring.md",
    "key-management-authoring.md",
    "jwks-integration-authoring.md",
    "host-provenance-authoring.md",
    "exact-approval-authoring.md"
  ],
  "limitations": [
    "Read-only source interface handoff; no source QA or runtime certification.",
    "No tests/compiler/build/lint/gates/services/dependency changes or product writes.",
    "No D0 fixture or session-manager work.",
    "C05 original provider completion, parent integration, shipping and V1/V2 gates remain separate.",
    "Later resource projection changes require refreshed hashes and a superseding handoff."
  ]
